    {
      "dot": "rose",
      "title": "Friction",
      "items": [
        "Five stores: tracker, TSV log, brief files, ulw notepad, Pi Task JSON",
        "Orchestrator cannot read worker notes; it scrapes the screen with hc read",
        "Handoff is a one-shot file; nothing tracks it after the cut"
      ]
    },
    {
      "dot": "amber",
      "title": "Duplication",
      "items": [
        "Task graph lives twice: tracker blocking links and queued needs= log rows",
        "log.sh re-implements task keys, latest-row state and dependency gating"
      ]
    },
