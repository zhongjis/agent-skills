  "cards": [
    {
      "dot": "cyan",
      "title": "Records",
      "items": [
        "Ticket: remote, optional; a task bead can exist without one",
        "Task bead: one outcome, one worker holding the claim at a time",
        "Task beads block each other with `blocks` links"
      ]
    },
    {
      "dot": "emerald",
      "title": "Writing",
      "items": [
        "Actor: name a write is recorded under (o-, w-, r-, h-)",
        "Claim: atomically make an actor the assignee",
        "Notepad: the living doc in the notes field",
        "Event: milestone comment, first line event=<name>; Report: a worker's handoff-point event"
      ]
    },
    {
      "dot": "amber",
      "title": "Flow words",
      "items": [
        "Import / re-pull: ticket into its bead, one way, never sync",
        "Re-instruction: a later message to a worker",
        "Settled: result accounted for with evidence",
        "Follow-up discovered-from may also point at a task bead"
      ]
    }
  ]
